# Copy to .env.local for development. Never commit .env.local.
#
# Every variable below says what breaks while it is unset and which standing
# client question (docs/CLIENT-QUESTIONS.md) resolves it. None of them are
# required for `npm run build` — preview deploys must work keyless. The three
# launch-blocking ones are enforced by `npm run check:launch`, which is run
# before go-live, never as part of the build.

# Canonical origin for canonicals, sitemap entries, OG images and JSON-LD @ids.
# Unset: falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel, then to
# http://localhost:3000 — so previews work, but production would publish
# localhost/preview URLs to crawlers. Launch-blocking. Resolved by Q10
# (domain + DNS access).
NEXT_PUBLIC_SITE_URL=

# GA4 measurement id, e.g. G-ABC1234567. Unset: GA simply does not load — no
# broken tag, no console noise. Vercel Analytics needs no config. Confirm
# privacy disclosure before enabling in production. Resolved by Q11 (analytics
# to keep).
NEXT_PUBLIC_GA_ID=

# Where validated leads are delivered. Unset: the notifier falls back to
# logging the lead on the server at error level — nothing is silently dropped,
# but no human is told. Launch-blocking. Resolved by Q2 (lead routing).
LEAD_NOTIFY_TO=

# Resend API key for lead email delivery. Unset: same console fallback as
# above, even if LEAD_NOTIFY_TO is set. Launch-blocking. Resolved by Q2 (lead
# routing — create the key in the client's own Resend account, not ours).
RESEND_API_KEY=

# From-address for lead emails. Unset: falls back to onboarding@resend.dev,
# which Resend accepts without domain verification — fine for smoke tests,
# wrong for launch (deliverability, and replies go nowhere). Resolved by Q10
# (domain access) once the client's domain is verified in Resend.
LEAD_NOTIFY_FROM=
